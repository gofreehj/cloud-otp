{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-otp",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudotp-db",
      "database_id": "0c6bfea8-9c24-4c51-ac3d-750dedaa1574",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
